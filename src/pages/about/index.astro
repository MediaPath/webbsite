---
export const prerender = true

import Layout, { type SEOProps } from '~/layouts/Layout.astro'
import { createWebPageSchema } from '~/utils/schema'

const operatorTypes = [
  'Licensed sportsbook operators',
  'Online casino brands',
  'Social casino & sweepstakes',
  'Multi-market gaming groups',
  'Regional LATAM & African operators',
  'US state-regulated sportsbooks',
  'Affiliate acquisition platforms',
]

const verticals = ['Sportsbook', 'Casino']

const geos = [
  'United States',
  'Canada',
  'United Kingdom',
  'Argentina',
  'Colombia',
  'Peru',
  'South Africa',
]

const seo: SEOProps = {
  title: 'About iGaming Growth Consultancy in Europe | MediaPath',
  description:
    'MediaPath OÜ is an Estonia-based iGaming growth agency founded in 2024. We partner with licensed sportsbook and casino operators across global markets.',
  keywords:
    'about mediapath, igaming consultancy europe, user acquisition experts, mediapath ou estonia, sportsbook marketing agency',
  canonical: `${Astro.site}about/`,
  image: `${Astro.site}images/mediapath-og.webp`,
  ldJSON: createWebPageSchema({
    name: 'About MediaPath EU',
    url: `${Astro.site}about/`,
    description:
      'MediaPath OÜ is an Estonia-based iGaming growth agency founded in 2024. We partner with licensed sportsbook and casino operators across global markets.',
    image: `${Astro.site}images/mediapath-og.webp`,
  }),
}
---

<Layout seo={seo}>
  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="grid gap-8 md:grid-cols-[1fr_0.9fr] md:items-center">
      <div>
        <h1 class="text-4xl font-black tracking-tight text-slate-900 md:text-5xl">About MediaPath EU</h1>
        <p class="mt-5 text-lg text-slate-700">
          MediaPath is a dedicated affiliate marketing and digital media buying agency specialized in iGaming. We combine sector expertise with practical execution
          to help brands grow faster and smarter.
        </p>
        <p class="mt-4 text-slate-700">
          We focus on high-quality user acquisition, scalable campaign structures, and measurable outcomes. Every strategy is tailored to your market priorities,
          budget constraints, and growth targets.
        </p>
      </div>
      <img
        src="/images/mediapath-logo.webp"
        alt="MediaPath EU brand logo"
        width="124"
        height="98"
        class="mx-auto h-44 w-56 rounded-3xl border border-slate-200 bg-white object-contain p-8 shadow-sm"
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="mt-10 rounded-3xl border border-slate-200 bg-slate-50 p-8 md:p-10">
      <h2 class="text-2xl font-black text-slate-900 md:text-3xl">Company</h2>
      <dl class="mt-6 grid gap-5 sm:grid-cols-2">
        <div>
          <dt class="text-sm font-semibold uppercase tracking-wide text-slate-500">Legal entity</dt>
          <dd class="mt-1 text-lg font-semibold text-slate-900">MediaPath OÜ</dd>
          <dd class="mt-1 text-slate-700">A private limited company incorporated under the laws of Estonia.</dd>
        </div>
        <div>
          <dt class="text-sm font-semibold uppercase tracking-wide text-slate-500">Registry code</dt>
          <dd class="mt-1 text-lg font-semibold text-slate-900">17000688</dd>
        </div>
        <div>
          <dt class="text-sm font-semibold uppercase tracking-wide text-slate-500">Country</dt>
          <dd class="mt-1 text-lg font-semibold text-slate-900">Estonia</dd>
        </div>
        <div>
          <dt class="text-sm font-semibold uppercase tracking-wide text-slate-500">Founded</dt>
          <dd class="mt-1 text-lg font-semibold text-slate-900">2024</dd>
        </div>
      </dl>
    </div>

    <div class="mt-10 rounded-3xl border border-slate-200 bg-white p-8 md:p-10">
      <h2 class="text-2xl font-black text-slate-900 md:text-3xl">Who We Work With</h2>
      <p class="mt-4 max-w-3xl text-slate-700">
        We support established and scaling iGaming operators — from US state-licensed sportsbooks and pan-European gaming groups to LATAM and African market
        leaders, social casino brands, and affiliate acquisition platforms.
      </p>

      <h3 class="mt-8 text-lg font-bold text-slate-900">Operator types</h3>
      <ul class="mt-4 flex flex-wrap gap-2">
        {
          operatorTypes.map((type) => (
            <li class="rounded-full border border-slate-200 bg-slate-50 px-4 py-2 text-sm font-medium text-slate-700">{type}</li>
          ))
        }
      </ul>

      <h3 class="mt-8 text-lg font-bold text-slate-900">Verticals</h3>
      <ul class="mt-4 flex flex-wrap gap-2">
        {
          verticals.map((vertical) => (
            <li class="rounded-full bg-slate-900 px-4 py-2 text-sm font-semibold text-white">{vertical}</li>
          ))
        }
      </ul>

      <h3 class="mt-8 text-lg font-bold text-slate-900">Markets</h3>
      <p class="mt-3 text-slate-700">
        Our team has hands-on experience across regulated and emerging markets worldwide. Recent focus areas include:
      </p>
      <ul class="mt-4 flex flex-wrap gap-2">
        {
          geos.map((geo) => (
            <li class="rounded-full border border-cyan-200 bg-cyan-50 px-4 py-2 text-sm font-medium text-cyan-900">{geo}</li>
          ))
        }
      </ul>
      <p class="mt-4 text-sm text-slate-600">We are not limited to these geographies — we scale campaigns wherever your licence and growth targets take you.</p>
    </div>

    <div class="mt-10 rounded-3xl bg-slate-900 p-8 text-white md:p-10">
      <h2 class="text-2xl font-black md:text-3xl">What Makes MediaPath Different</h2>
      <p class="mt-4 text-slate-200">
        Our global reach and innovative approach let us activate the best mix of affiliate partnerships and media buying channels for your goals. We help iGaming
        platforms reach the right audience at the right time while optimizing for engagement and efficiency.
      </p>
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      <article class="rounded-2xl border border-slate-200 bg-white p-6">
        <h2 class="text-xl font-bold text-slate-900">Core Expertise</h2>
        <p class="mt-3 text-slate-700">Affiliate marketing, digital media buying, and acquisition technology built around performance and long-term growth.</p>
      </article>
      <article class="rounded-2xl border border-slate-200 bg-white p-6">
        <h2 class="text-xl font-bold text-slate-900">Mission</h2>
        <p class="mt-3 text-slate-700">Deliver measurable and sustainable user acquisition outcomes for iGaming companies operating in competitive markets.</p>
      </article>
    </div>

    <div class="mt-10 rounded-3xl border border-slate-200 bg-white p-8 text-center">
      <h2 class="text-2xl font-black text-slate-900 md:text-3xl">Start your affiliate campaign with MediaPath</h2>
      <p class="mt-3 text-slate-700">Ready to scale traffic and user acquisition? Build your next growth sprint with a team specialized in iGaming.</p>
      <a href="/contact/" class="mt-6 inline-flex rounded-full bg-slate-900 px-6 py-3 text-sm font-semibold text-white transition hover:bg-slate-950">Work with us</a>
    </div>
  </section>
</Layout>
