---
export const prerender = true

import Layout, { type SEOProps } from '~/layouts/Layout.astro'
import { createWebPageSchema } from '~/utils/schema'

const siteUrl = Astro.site?.toString() ?? 'https://mediapath.eu/'
const sent = Astro.url.searchParams.get('sent') === '1'

const seo: SEOProps = {
  title: 'Contact iGaming Marketing Agency Team | MediaPath EU',
  description:
    'Contact MediaPath EU for iGaming affiliate marketing and media buying support. Send a message via our contact form and the growth team will reply soon.',
  keywords: 'contact mediapath, igaming marketing agency contact, mediapath contact form, affiliate marketing enquiry',
  canonical: `${siteUrl}contact/`,
  image: `${siteUrl}images/mediapath-og.webp`,
  ldJSON: createWebPageSchema({
    name: 'Contact MediaPath EU',
    url: `${siteUrl}contact/`,
    description:
      'Contact MediaPath EU for iGaming affiliate marketing and media buying support. Send a message via our contact form and the growth team will reply soon.',
    image: `${siteUrl}images/mediapath-og.webp`,
  }),
}
---

<Layout seo={seo}>
  <section class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="text-4xl font-black tracking-tight text-slate-900 md:text-5xl">Contact MediaPath EU</h1>
    <p class="mt-5 text-lg text-slate-700">
      Reach our iGaming growth team for affiliate partnerships, media buying, and user acquisition support.
    </p>

    {
      sent && (
        <p class="mt-6 rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-800" role="status">
          Thank you — your message has been sent. We will respond as soon as possible.
        </p>
      )
    }

    <form
      class="mt-10 rounded-3xl border border-slate-200 bg-white p-8"
      action="https://formsubmit.co/team.mediapath@gmail.com"
      method="POST"
      aria-label="Contact MediaPath EU"
    >
      <h2 class="text-xl font-bold text-slate-900">Send a message</h2>
      <p class="mt-2 text-sm text-slate-600">Fill in the details below and we will get back to you.</p>

      <input type="hidden" name="_subject" value="MediaPath EU website contact form" />
      <input type="hidden" name="_next" value={`${siteUrl}contact/?sent=1`} />
      <input type="hidden" name="_captcha" value="false" />
      <input type="text" name="_honey" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

      <div class="mt-6 grid gap-5">
        <div>
          <label for="contact-name" class="block text-sm font-semibold text-slate-700">Name</label>
          <input
            id="contact-name"
            name="name"
            type="text"
            required
            autocomplete="name"
            class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3 text-slate-900 focus-visible:ring-2 focus-visible:ring-cyan-500 focus-visible:outline-none"
          />
        </div>

        <div>
          <label for="contact-email" class="block text-sm font-semibold text-slate-700">Email</label>
          <input
            id="contact-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3 text-slate-900 focus-visible:ring-2 focus-visible:ring-cyan-500 focus-visible:outline-none"
          />
        </div>

        <div>
          <label for="contact-company" class="block text-sm font-semibold text-slate-700">Company (optional)</label>
          <input
            id="contact-company"
            name="company"
            type="text"
            autocomplete="organization"
            class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3 text-slate-900 focus-visible:ring-2 focus-visible:ring-cyan-500 focus-visible:outline-none"
          />
        </div>

        <div>
          <label for="contact-message" class="block text-sm font-semibold text-slate-700">Message</label>
          <textarea
            id="contact-message"
            name="message"
            rows="5"
            required
            class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3 text-slate-900 focus-visible:ring-2 focus-visible:ring-cyan-500 focus-visible:outline-none"
          ></textarea>
        </div>
      </div>

      <button
        type="submit"
        class="mt-6 inline-flex rounded-full bg-slate-900 px-6 py-3 text-sm font-semibold text-white transition hover:bg-slate-950 focus-visible:ring-2 focus-visible:ring-cyan-500 focus-visible:outline-none"
      >
        Send message
      </button>
    </form>
  </section>
</Layout>
